generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

model Jamaah {
  id              String            @id @default(uuid())
  nama            String
  email           String            @unique
  no_hp           String
  nik             String            @unique
  alamat             String?           @db.Text
  foto_url           String?           @db.LongText
  password_hash      String
  password_plain     String?
  reset_token        String?
  reset_token_expiry DateTime?
  created_at         DateTime          @default(now())
  RencanaTabungan    RencanaTabungan[]
  RiwayatBlast       RiwayatBlast[]
}

model Paket {
  id                    String            @id @default(uuid())
  nama_paket            String
  tanggal_keberangkatan DateTime
  tanggal_kepulangan    DateTime
  hotel_makkah          String
  hotel_madinah         String
  maskapai              String
  harga_quad            Decimal
  harga_double          Decimal
  harga_triple          Decimal
  kuota                 Int
  deskripsi_fasilitas   String?           @db.Text
  poster_url            String?           @db.LongText
  is_estimasi           Boolean           @default(false)
  is_deleted            Boolean           @default(false)
  RencanaTabungan       RencanaTabungan[]
}

model Pengumuman {
  id         String   @id @default(uuid())
  judul      String
  konten     String   @db.Text
  is_penting Boolean  @default(false)
  is_pinned  Boolean  @default(false)
  created_at DateTime @default(now())
}


model RencanaTabungan {
  id                String           @id @default(uuid())
  id_jamaah         String
  id_paket          String?
  jenis_kamar       String
  jumlah_jamaah     Int              @default(1)
  periode_bulan     Int
  total_biaya       Decimal
  setoran_per_bulan Decimal
  tanggal_mulai     DateTime
  status            String

  // Snapshot fields
  paket_snapshot_nama            String?
  paket_snapshot_is_estimasi     Boolean?
  paket_snapshot_tanggal_berangkat DateTime?
  paket_snapshot_tanggal_kepulangan DateTime?
  paket_snapshot_maskapai        String?

  jamaah            Jamaah           @relation(fields: [id_jamaah], references: [id])
  paket             Paket?           @relation(fields: [id_paket], references: [id], onDelete: SetNull)
  RiwayatSetoran    RiwayatSetoran[]
}

model RiwayatSetoran {
  id                   String          @id @default(uuid())
  id_rencana_tabungan  String
  bulan_ke             Int
  tanggal_setor        DateTime
  nominal              Decimal
  status_pembayaran    String
  id_transaksi_gateway String?
  rencana_tabungan     RencanaTabungan @relation(fields: [id_rencana_tabungan], references: [id])
}

model Setting {
  key   String @id
  value String @db.Text
}

model RiwayatBlast {
  id               String   @id @default(uuid())
  id_jamaah        String
  jenis_pesan      String   // e.g. "Pengingat Cicilan"
  status_email     String   // "Sukses", "Gagal", "Pending"
  status_wa        String   // "Sukses", "Gagal", "Pending"
  keterangan_email String?  @db.Text
  keterangan_wa    String?  @db.Text
  tanggal_kirim    DateTime @default(now())

  jamaah           Jamaah   @relation(fields: [id_jamaah], references: [id])
}
